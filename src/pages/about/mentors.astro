---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <main
        class="flex flex-col items-center pt-8 w-full min-h-screen container mx-auto mb-10 text-center"
    >
        <div class="max-w-3xl px-5 w-full">
            <h1 class="font-bold text-4xl mb-5">Mentors</h1>
            <ul class="list-inside list-disc space-y-4 text-left">
                <li>
                    <strong>Ms. Ramirez</strong> is our lead coach and comp sci teacher
                    at Fairmont Prep. She always emphasizes the importance of creativity
                    as a team.
                </li>
                <li>
                    <strong>Mr. Lengsfeld</strong> works by advising all our sub-teams
                    in technical challenges, and how we can improve the Huskyteers
                    as a single unit.
                </li>
                <li>
                    <strong>Mr. Fawcett</strong> helps us with the design of our robot,
                    and ensures that we stay organized by promoting good build practices.
                </li>
            </ul>
        </div>
    </main>
</Layout>
