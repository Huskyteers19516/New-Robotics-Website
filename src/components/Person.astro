<div class="card w-48 bg-base-300 shadow-sm shadow-base-300 rounded-lg p-3">
    <!-- <CardHeader className="pb-3 pt-5"> -->
    <div
        class="card-title text-center min-h-8 flex items-center justify-center"
    >
        {Astro.props.name}
    </div>
    <!-- </CardHeader> -->
    <div class="card-body flex justify-center items-center bg">
        {
            Astro.props.image ? (
                <img
                    src={Astro.props.image}
                    width={128}
                    height={128}
                    alt={name + "'s profile picture"}
                    class="w-32 h-32 rounded-full"
                />
            ) : (
                <div class="w-32 h-32 rounded-full bg-gray-300" />
            )
        }
    </div>

    <div class="">
        <div class="text-center mx-auto">
            {Astro.props.roles}
        </div>
    </div>
</div>
